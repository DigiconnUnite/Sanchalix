APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27018/vidyawan?directConnection=true
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Two-step verification for school admins, principals and accountants. Off during development (ADR-019).
# It must be true before any real school data is loaded.
TWO_FACTOR_ENABLED=false

# Optional. Google sign-in for staff appears when both are set.
# Redirect URI to register with Google: {APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional. Turns on POST /api/webhooks/razorpay.
# RAZORPAY_WEBHOOK_SECRET=

# Secret for the timer that calls GET /api/cron/tick (overdue marking, late fees). Any long random string.
# CRON_SECRET=
