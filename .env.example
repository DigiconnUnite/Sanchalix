APP_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27018/vidyawan?directConnection=true
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Two-step verification for school admins, principals and accountants. Off during development (ADR-019).
# It must be true before any real school data is loaded.
TWO_FACTOR_ENABLED=false

# Optional. Google sign-in for staff appears when both are set.
# Redirect URI to register with Google: {APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional. With the first two, online payments are made at Razorpay; without them the stand-in gateway is used.
# The webhook secret turns on POST /api/webhooks/razorpay (register {APP_URL}/api/webhooks/razorpay with Razorpay).
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Where uploaded files are kept (student and staff documents, homework and announcement attachments). Required in
# production. Without it files are written to .data/uploads, for development only. Credentials come from the host's
# role, or from AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY.
# S3_BUCKET_DOCUMENTS=
# AWS_REGION=ap-south-1

# Secret for the timer that calls GET /api/cron/tick (overdue and late fees, scheduled announcements, held texts,
# payment reconciliation). Any long random string.
# CRON_SECRET=
